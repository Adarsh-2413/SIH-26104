# ─── Application ─────────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# ─── MongoDB Atlas ────────────────────────────────────────────
# Replace with your actual Atlas connection string
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/sih26104?retryWrites=true&w=majority
MONGODB_DB_NAME=sih26104

# ─── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173

# ─── Audio Sliding Window ────────────────────────────────────
AUDIO_WINDOW_SIZE=10
AUDIO_STEP_SIZE=2

# ─── Risk Engine Weights (must sum to 1.0) ───────────────────
RISK_WEIGHT_SPOOF=0.55
RISK_WEIGHT_SPEAKER=0.25
RISK_WEIGHT_PROSODIC=0.10
RISK_WEIGHT_PHONETIC=0.05
RISK_WEIGHT_CONTEXT=0.05

# ─── Risk Classification Thresholds ──────────────────────────
RISK_THRESHOLD_SAFE_MAX=39
RISK_THRESHOLD_SUSPICIOUS_MAX=69

ML_SERVICE_URL=http://localhost:5000/predict
